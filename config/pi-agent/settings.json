{
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-usage",
    "npm:pi-subagents",
    "npm:pi-lens",
    "npm:context-mode",
    "npm:@dietrichgebert/ponytail",
    "npm:bigpowers",
    "npm:pi-claude-bridge",
    "./packages/pi-skill-parity",
    "npm:pi-mcp-adapter"
  ],
  "lastChangelogVersion": "0.84.2",
  "theme": "dark",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-fable-5",
  "defaultThinkingLevel": "high",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "claude-bridge/claude-fable-5",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "oracle": {
        "model": "claude-bridge/claude-fable-5",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "worker": {
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "delegate": {
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol"
        ]
      }
    }
  }
}