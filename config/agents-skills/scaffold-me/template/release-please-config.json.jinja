[% import pathjoin('template', '_profiles', profile, 'values.jinja') as profile_values with context -%]
{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "[[ profile_values.RELEASE_TYPE ]]",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "[[ project_slug ]]",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "version.txt"
        }[% if profile == 'typescript' %],
        {
          "type": "generic",
          "path": "src/index.ts"
        },
        {
          "type": "generic",
          "path": "tests/smoke.test.ts"
        }[% endif %]
      ]
    }
  }
}
