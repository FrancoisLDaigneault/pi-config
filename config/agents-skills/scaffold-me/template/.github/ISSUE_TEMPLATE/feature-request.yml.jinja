name: Feature request
description: Propose a concrete improvement to [[ project_name | trim ]].
title: "[Feature]: "
labels:
  - enhancement
body:
  - type: textarea
    id: problem
    attributes:
      label: Problem
      description: What current problem is not solved?
    validations:
      required: true
  - type: textarea
    id: outcome
    attributes:
      label: Desired outcome
      description: Describe the observable result, not an implementation plan.
    validations:
      required: true
  - type: textarea
    id: evidence
    attributes:
      label: Evidence or examples
  - type: checkboxes
    id: scope
    attributes:
      label: Scope check
      options:
        - label: This solves a current need rather than a hypothetical future use.
          required: true
