root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yaml,yml,toml,xml,html,htm,css,scss,sass,less,js,jsx,ts,tsx,mjs,cjs,vue,svelte}]
indent_size = 2

[*.{csproj,fsproj,vbproj,props,targets,xaml}]
indent_size = 2

[*.{sh,bash,zsh,fish}]
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.{md,mdx,diff,patch}]
trim_trailing_whitespace = false
