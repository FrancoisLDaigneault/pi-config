# Python bytecode and caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Build and distribution artifacts
build/
dist/
*.egg-info/
.eggs/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
test-results.xml

# Security: never commit secrets or memory databases
auth.json
*.sqlite3*

# OS noise
Thumbs.db
desktop.ini
.DS_Store
*~

# Editors
.vscode/
.idea/
*.swp
*.swo

# Generated Graphify knowledge-graph artifacts
graphify-out/

# Transient sync working directories: config/ is rebuilt beside itself and the
# previous snapshot is kept aside until the swap lands. A hard kill can leave
# one behind, and the documented pre-commit workflow runs `git add -A`.
.config-staging-*/
config.old-*/
