#!/bin/sh
# Gate pre-commit : ruff + tests unitaires. Active par : git config core.hooksPath hooks
# Doit rester rapide (< 10 s) ; les suites integration/e2e tournent en CI.
set -e
cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] ruff check ..."
uv run ruff check .

echo "[pre-commit] pytest tests/unit ..."
uv run pytest tests/unit -q

echo "[pre-commit] OK"
