#!/bin/sh
# Gate pre-commit : ruff + mypy + suite complete. Active par : git config core.hooksPath hooks
# Doit rester rapide (< 10 s) ; la suite entiere tourne en ~0.6 s, tres sous le budget.
set -e
cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] ruff check ..."
uv run ruff check .

echo "[pre-commit] mypy ..."
uv run mypy

echo "[pre-commit] pytest ..."
uv run pytest -q

echo "[pre-commit] OK"
