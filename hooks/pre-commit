#!/bin/sh
# Pre-commit gate: ruff + mypy + full suite. Enabled via: git config core.hooksPath hooks
# Must stay fast (< 10 s); the whole suite runs in ~0.6 s, well under budget.
set -e
cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] ruff check ..."
uv run ruff check .

echo "[pre-commit] mypy ..."
uv run mypy

echo "[pre-commit] pytest ..."
uv run pytest -q

echo "[pre-commit] OK"
